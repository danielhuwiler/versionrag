# Neo4j — must match docker-compose.yml
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334

# OpenAI — indexing, generation and embeddings
OPENAI_API_KEY=
# Optional: separate key if the main one has no embedding access
OPENAI_EMBEDDING_API_KEY=

# OpenRouter — used only for model names containing "/", e.g. mistralai/mistral-small-2603
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MAX_CONCURRENT=10
